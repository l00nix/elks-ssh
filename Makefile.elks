TOPDIR ?= ../..

CC = ia16-elf-gcc
PROGRAM ?= dbclient
OBJDIR = obj-elks/$(PROGRAM)
DBCLIENT = dbclient

# Missing strong randomness must stop a connection, never use the old fallback.
CPPFLAGS = -I. -I src -I libtomcrypt/src/headers -DLOCALOPTIONS_H_EXISTS -DDROPBEAR_ELKS_WEAK_RANDOM=0
CFLAGS = -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 -Wall -Os \
	-fomit-frame-pointer -fno-strict-overflow -Wno-pointer-sign \
	-Werror=implicit-function-declaration -Werror=incompatible-pointer-types -Werror=overflow
HEADERS = $(wildcard src/*.h libtomcrypt/src/headers/*.h) config.h localoptions.h

DBCLIENT_SRCS = \
	dbutil buffer dbhelpers signkey dbrandom queue atomicio compat fake-rfc2553 \
	ltc_prng crypto_desc curve25519 ed25519 dbmalloc common-session packet \
	common-algo common-kex common-channel common-chansession termcodes \
	loginrec listener process-packet common-runopts circbuffer list netio \
	chachapoly kex-x25519 cli-main cli-auth cli-authpasswd cli-authpubkey \
	cli-kex cli-session cli-runopts cli-chansession cli-channel cli-authinteract

# Keep client/server objects separate: their compile-time layouts differ.
ifeq ($(PROGRAM),dbclient)
CPPFLAGS += -DDROPBEAR_CLIENT=1
PROGRAM_SRCS = $(DBCLIENT_SRCS)
else ifeq ($(PROGRAM),dropbear)
CPPFLAGS += -DDROPBEAR_SERVER=1
PROGRAM_SRCS = $(filter-out cli-%,$(DBCLIENT_SRCS)) \
	tcp-accept svr-kex svr-auth sshpty svr-authpasswd svr-authpubkey \
	svr-authpubkeyoptions svr-session svr-service svr-chansession svr-runopts \
	svr-main svr-tcpfwd
else
$(error Unsupported PROGRAM $(PROGRAM))
endif

LTC_SRCS = \
	hashes/sha2/sha256 hashes/sha2/sha512 hashes/helper/hash_memory \
	mac/hmac/hmac_init mac/hmac/hmac_process mac/hmac/hmac_done \
	mac/poly1305/poly1305 misc/base64/base64_encode misc/base64/base64_decode \
	misc/crypt/crypt_argchk misc/crypt/crypt_find_hash \
	misc/crypt/crypt_hash_descriptor misc/crypt/crypt_hash_is_valid \
	misc/crypt/crypt_register_hash misc/zeromem \
	stream/chacha/chacha_setup stream/chacha/chacha_ivctr64 \
	stream/chacha/chacha_crypt stream/chacha/chacha_keystream

PROGRAM_OBJS = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(PROGRAM_SRCS)))
LTC_OBJS = $(addprefix $(OBJDIR)/ltc/,$(addsuffix .o,$(LTC_SRCS)))

.PHONY: all clean

all: $(PROGRAM)

$(PROGRAM): default_options_guard.h $(PROGRAM_OBJS) $(LTC_OBJS)
	$(CC) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 -maout-heap=8192 -maout-stack=8192 -o $@ $(PROGRAM_OBJS) $(LTC_OBJS)

# Development-only regression executable; never installed as a service.
wiretest: $(OBJDIR)/wiretest.o $(OBJDIR)/buffer.o $(OBJDIR)/dbmalloc.o $(OBJDIR)/chachapoly.o $(LTC_OBJS)
	$(CC) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 -maout-heap=2048 -maout-stack=4096 -o $@ $^

$(OBJDIR)/wiretest.o: tests/wiretest.c default_options_guard.h $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

default_options_guard.h: src/default_options.h src/ifndef_wrapper.sh
	@printf "/*\n > > > Do not edit this file (default_options_guard.h) < < <\nGenerated from src/default_options.h\nLocal customisation goes in localoptions.h\n*/\n\n" > $@.tmp
	@./src/ifndef_wrapper.sh < src/default_options.h >> $@.tmp
	@mv $@.tmp $@

$(OBJDIR)/%.o: src/%.c default_options_guard.h $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(OBJDIR)/ltc/%.o: libtomcrypt/src/%.c default_options_guard.h $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJDIR) $(PROGRAM)
