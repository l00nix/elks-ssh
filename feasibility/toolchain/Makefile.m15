# MIT. Experimental overlay; invoke from the repository root. Never installed.
override PROGRAM = dropbear
override OBJDIR = obj-elks/m15-$(if $(filter 1,$(TEST_ENTROPY)),qemu,normal)
override OUTPUT = $(if $(filter 1,$(TEST_ENTROPY)),dropbear-m15-qemu,dropbear-m15)
include Makefile.elks

M15_ROOT = feasibility/vendor/bearssl
M15_HEADERS = $(wildcard $(M15_ROOT)/inc/*.h $(M15_ROOT)/src/*.h)
M15_OBJS = $(OBJDIR)/m15-adapter.o $(OBJDIR)/m15-curve.o $(OBJDIR)/m15-ccopy.o $(OBJDIR)/exec-diagnostic.o
M15_FLAGS = -I$(M15_ROOT)/inc -I$(M15_ROOT)/src -DBR_NO_ARITH_SHIFT=1 \
            -DBR_SLOW_MUL15=0 -DBR_CT_MUL15=0
M15_MAKEFILE = feasibility/toolchain/Makefile.m15

EXTRA_OBJS += $(M15_OBJS)
$(OUTPUT): $(M15_OBJS)

# Rename only the KEX call sites and their declaration. Keep Ed25519 and all
# protocol checks, including all-zero shared-secret rejection, unchanged.
$(OBJDIR)/kex-x25519.o: CPPFLAGS += -Ddropbear_curve25519_scalarmult=elkssh_m15_scalarmult
$(OBJDIR)/kex-x25519.o: $(M15_MAKEFILE)

$(OBJDIR)/dbutil.o: CPPFLAGS += -Dexecv=elkssh_probe_execv
$(OBJDIR)/dbutil.o: $(M15_MAKEFILE)

$(OBJDIR)/exec-diagnostic.o: feasibility/src/exec-diagnostic.c $(M15_MAKEFILE)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(OBJDIR)/m15-adapter.o: feasibility/src/m15-adapter.c $(HEADERS) $(M15_HEADERS) $(M15_MAKEFILE)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) $(M15_FLAGS) -DELKSSH_M15_EXPERIMENT -c $< -o $@

$(OBJDIR)/m15-curve.o: $(M15_ROOT)/src/ec/ec_c25519_m15.c $(M15_HEADERS) $(M15_MAKEFILE) feasibility/src/m15-placement.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(M15_FLAGS) -include feasibility/src/m15-placement.h -fwrapv -fstack-usage -c $< -o $@

$(OBJDIR)/m15-ccopy.o: $(M15_ROOT)/src/codec/ccopy.c $(M15_HEADERS) $(M15_MAKEFILE)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(M15_FLAGS) -c $< -o $@

# Public RFC 8032 probe linked with this build's unchanged Dropbear/LTC objects.
edbench: $(OBJDIR)/edbench.o $(OBJDIR)/curve25519.o \
         $(OBJDIR)/ltc/hashes/sha2/sha512.o $(OBJDIR)/ltc/misc/crypt/crypt_argchk.o
	$(CC) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
	    -maout-heap=1024 -maout-stack=8192 -o $@ $^

$(OBJDIR)/edbench.o: feasibility/src/edbench.c src/curve25519.h $(M15_MAKEFILE)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Isrc -c $< -o $@

m15bench: $(OBJDIR)/m15bench.o $(OBJDIR)/m15-curve.o $(OBJDIR)/m15-ccopy.o
	$(CC) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
	    -maout-heap=1024 -maout-stack=8192 -o $@ $^

$(OBJDIR)/m15bench.o: feasibility/src/xbench.c feasibility/src/x25519-vectors.h $(M15_HEADERS) $(M15_MAKEFILE)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(M15_FLAGS) -DUSE_BEARSSL -DBACKEND_NAME=\"daemon-m15\" -c $< -o $@
